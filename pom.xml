<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Pinned Spring Boot version (Security Baseline: pin dependency versions). -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>event-sourced-ledger</artifactId>
    <version>1.0.0</version>
    <name>event-sourced-ledger</name>
    <description>An event-sourced ledger: append-only events, projections, replay, and snapshots</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- REST layer -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Bean Validation for incoming commands -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
        NOTE: There is deliberately no database, no message broker, and no Docker.
        The event store, snapshot store, and read model are all in-memory, so the
        whole application runs with `mvn spring-boot:run` and nothing else installed.
        Each store sits behind an interface, so a real backend (PostgreSQL, Kafka)
        can be dropped in later without touching the domain logic.
    -->

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
